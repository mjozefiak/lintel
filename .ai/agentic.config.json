{
  "version": 1,
  "baseBranch": "auto",
  "tracker": "github",
  "browser": {
    "provider": "agent-browser"
  },
  "validation": {
    "commands": [
      "swift build",
      "swift test",
      "swift format lint --strict -r Sources Tests"
    ]
  },
  "labels": {
    "enabled": true,
    "pipeline": [
      "review",
      "changes-requested",
      "qa",
      "qa-failed",
      "merge-queue",
      "blocked",
      "do-not-merge"
    ],
    "category": [
      "type:bug",
      "type:feature",
      "type:chore",
      "security"
    ],
    "meta": [
      "needs-qa",
      "needs-human-qa",
      "skip-qa",
      "qa-approved",
      "qa-self-verified",
      "in-progress",
      "ci-monitoring",
      "claim-reset",
      "automerge-signal-1-cr",
      "automerge-signal-2-qa",
      "automerge-signal-3-ci",
      "automerge-signal-3-passes-local-ci-checks"
    ],
    "priority": [],
    "risk": [
      "risk-low",
      "risk-medium",
      "risk-high"
    ],
    "area": [
      "area:dictation",
      "area:meetings",
      "area:notes",
      "area:app"
    ],
    "state": [
      "state:idea",
      "state:needs-decision",
      "state:agent-ready"
    ],
    "milestones": [
      "beta.2",
      "later"
    ]
  },
  "qaGate": true,
  "ci": {
    "maxWaitMinutes": 40,
    "approveHeldRunsOnReview": false
  },
  "automerge": {
    "label": "automerge",
    "mode": "prepare-and-merge",
    "requireIndependentReview": false,
    "defaultToHumanQa": false,
    "humanOnlyLabels": [
      "risk-high",
      "state:needs-decision"
    ],
    "humanOnlyAuthors": [],
    "complexQa": "always",
    "windowMinutes": 120,
    "maxAttempts": 3,
    "eligibility": {
      "tiers": [
        [
          "qa-approved"
        ],
        [
          "ai-judgment"
        ],
        [
          "security",
          "small"
        ],
        [
          "trusted-author"
        ],
        [
          "fixes-issue"
        ]
      ],
      "smallPrFileLimit": 10,
      "aiJudgment": {
        "staleAfterDays": 7
      },
      "securityLabels": [
        "security"
      ],
      "trustedAuthors": [
        "mjozefiak"
      ],
      "excludeAuthorAssociations": [
        "first-time-contributor",
        "outside-collaborator",
        "none"
      ],
      "excludeLabels": [
        "do-not-merge",
        "blocked",
        "qa-failed"
      ],
      "lookbackDays": 30,
      "analyzeLimit": 100,
      "limit": 20
    }
  },
  "engine": {
    "loopStepThreshold": 20,
    "executorTier": "standard",
    "stepReview": "final"
  },
  "reviewSweep": {
    "maxParallel": 1,
    "coordinationRoot": null
  },
  "paths": {
    "runs": ".ai/runs",
    "analysis": ".ai/analysis",
    "specs": ".ai/specs",
    "dataModel": ".ai/data-model",
    "prototypes": ".ai/prototypes",
    "scripts": ".ai/scripts",
    "qa": ".ai/qa"
  },
  "designTokens": null,
  "reviewChecklist": null,
  "agentHarness": {
    "version": 1,
    "preset": "custom",
    "host": "claude",
    "delivery": {
      "mode": "stage-only",
      "issueClaim": "hold"
    },
    "retry": {
      "maxAttempts": 4,
      "backoffMs": 5000,
      "backoffMultiplier": 2,
      "timeoutEscalation": 1.5,
      "maxTimeoutMs": 2400000
    },
    "models": {},
    "profiles": {
      "standard": {
        "workers": [],
        "reviewers": [],
        "reviewPolicy": {
          "mode": "advisory"
        }
      }
    }
  },
  "closeKeywords": [],
  "dependencyAudit": {
    "minSeverity": "high",
    "ignore": []
  },
  "prTitleTemplate": "{prefix}({area}): {summary}{issueRef}",
  "ticketKeyPattern": "",
  "qaGateLabel": "needs-human-qa",
  "qaReadyLabel": null,
  "humanQaPolicy": {
    "paths": [
      "Package.swift",
      "Package.resolved",
      "Packages/**",
      "Sources/LintelKit/**",
      "Sources/LintelPersistence/**",
      "Sources/LintelApp/PluginRegistry.swift",
      "Sources/ClipboardPlugin/**",
      "Resources/Info.plist",
      "Resources/*.entitlements",
      "Resources/designated-requirement.txt",
      ".github/workflows/**",
      "scripts/make-app.sh",
      "scripts/make-dmg.sh",
      "scripts/notarize.sh",
      "scripts/requirement.sh",
      "scripts/select-entitlements.sh",
      "scripts/sparkle-sign.sh",
      "scripts/make-appcast.sh",
      "scripts/release-appcast.sh"
    ],
    "uiPaths": [],
    "uiFileThreshold": 0,
    "whenUnsure": "human",
    "approvedDesign": {
      "source": "merged-spec",
      "label": null
    },
    "humanVerdictLabels": [],
    "trustedTriageAuthors": []
  }
}
